# =============================================================================
# Dimon storefront — local development example
# =============================================================================
# Copy this file to `.env.local` (recommended for Next.js) or `.env`.
# Never commit a real `.env.local`; this file only contains local test values.
# =============================================================================

# -----------------------------------------------------------------------------
# Admin API proxy
# -----------------------------------------------------------------------------
# The storefront proxies `/api/auth/*` to the admin app.
# This value is read by next.config.ts. Rebuild after changing it in production.
ADMIN_API_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Local network access
# -----------------------------------------------------------------------------
# Extra hostnames allowed to access the Next.js dev server.
# Comma-separated hosts, without scheme or port.
# Add your LAN IP when testing OAuth/Telegram from a phone, e.g.
#   localhost,127.0.0.1,192.168.0.114
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Bot API (optional for local auth work)
# -----------------------------------------------------------------------------
# tRPC endpoint used by server components for notifications/subscriptions.
# The bot service is not required for social-auth development.
BOT_API_URL=http://127.0.0.1:3100/trpc

# Shared key expected by the bot API. Local test value only.
NOTIFY_API_KEY=local-notify-api-key
