# Database
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/dimon
PAYLOAD_SECRET=change-me

# Public URLs
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Cookie domain. Leave empty on localhost, set to .example.com in production.
COOKIE_DOMAIN=

# Comma-separated origins allowed to call state-changing auth endpoints.
TRUSTED_REDIRECT_ORIGINS=http://localhost:3000

# Separate secret for social session/state cookies. Falls back to PAYLOAD_SECRET.
OAUTH_SESSION_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Yandex OAuth
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:3000/api/auth/yandex/callback

# Telegram Login Widget
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_AUTH_MAX_AGE=300
