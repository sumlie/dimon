# =============================================================================
# Dimon admin — local development example
# =============================================================================
# Copy this file to `.env` and adjust values for your machine.
# Never commit a real `.env` file. All secrets below are local-only examples.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local PostgreSQL database used by Payload.
# Example with a dedicated user:
#   postgresql://dimon:dimon@127.0.0.1:5432/dimon
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/dimon

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------
# Used to sign Payload tokens and cookies.
# Generate a strong value for anything other than local development:
#   openssl rand -hex 32
PAYLOAD_SECRET=dev-only-payload-secret-change-me-32-bytes

# Optional separate secret for social-auth state/session cookies.
# Falls back to PAYLOAD_SECRET when empty.
OAUTH_SESSION_SECRET=dev-only-oauth-session-secret-change-me-32-bytes

# -----------------------------------------------------------------------------
# Public URLs
# -----------------------------------------------------------------------------
# Storefront URL. OAuth callbacks are registered on this origin.
APP_URL=http://localhost:3000

# Admin app URL.
ADMIN_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Cookies and CSRF
# -----------------------------------------------------------------------------
# Leave empty on localhost. In production, use the shared parent domain, e.g.
#   COOKIE_DOMAIN=.example.com
COOKIE_DOMAIN=

# Origins allowed to call state-changing auth endpoints.
# Include both apps during local development.
TRUSTED_REDIRECT_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID.
# Authorized redirect URI:
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
# Example format: 123456789012-abcdefghijklmnop.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# Example format: GOCSPX-local-test-value
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# -----------------------------------------------------------------------------
# Yandex OAuth
# -----------------------------------------------------------------------------
# Yandex OAuth app → Web services.
# Redirect URI:
#   http://localhost:3000/api/auth/yandex/callback
# Scopes: login:email, login:info
YANDEX_CLIENT_ID=
# Example format: local-yandex-client-id
YANDEX_CLIENT_SECRET=
# Example format: local-yandex-client-secret
YANDEX_REDIRECT_URI=http://localhost:3000/api/auth/yandex/callback

# -----------------------------------------------------------------------------
# Telegram Login Widget
# -----------------------------------------------------------------------------
# Create a bot with @BotFather and copy the token.
# Configure the Login Widget domain for the storefront (localhost for local dev).
TELEGRAM_BOT_TOKEN=
# Example format: 123456789:AA-local-test-token-not-valid
TELEGRAM_BOT_USERNAME=
# Bot username without the leading @.
# Example: dimon_local_test_bot

# Reject Telegram auth payloads older than this many seconds.
TELEGRAM_AUTH_MAX_AGE=300
